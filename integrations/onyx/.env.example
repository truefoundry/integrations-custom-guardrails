# Copy to .env and fill in. Do NOT commit .env.

# --- Onyx AI Guard ---
# Policy token from https://onyx.security. Used in the evaluate URL path
# (POST {ONYX_API_BASE}/guard/evaluate/v1/{ONYX_API_KEY}/simple).
ONYX_API_KEY=
# Required: set this to your tenant's AI Guard host.
# https://ai-guard.onyx.security is not routed to any tenant (it 404s).
# Format: https://<routing-id>.ai-guard.onyx.security
ONYX_API_BASE=https://<routing-id>.ai-guard.onyx.security
# Optional: per-call timeout in seconds (default: 10)
# ONYX_TIMEOUT=10

# --- Wrapper auth (the TrueFoundry gateway calls us with this Bearer token) ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WRAPPER_API_KEY=change-me-to-a-random-string

# --- Server ---
PORT=8000
LOG_LEVEL=info

# --- TrueFoundry deploy (used by deploy.py only) ---
# Workspace FQN: `tfy workspace list` or copy from dashboard.
TFY_WORKSPACE_FQN=<cluster>:<workspace>
# Configured host: Integrations -> Clusters -> <cluster>.
TFY_PUBLIC_HOST=ml.<cluster>.truefoundry.cloud
# Path prefix for shared base domains. Leave blank if using wildcard subdomain.
TFY_PUBLIC_PATH=/onyx-guardrails-tfy
# Secret FQNs (create secrets first in TFY dashboard, then paste their FQNs here).
ONYX_API_KEY_SECRET_FQN=tfy-secret://<workspace>/onyx-guardrails-tfy/onyx-api-key
WRAPPER_API_KEY_SECRET_FQN=tfy-secret://<workspace>/onyx-guardrails-tfy/wrapper-api-key
