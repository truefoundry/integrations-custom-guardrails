# Copy to .env and fill in. Do NOT commit .env.

# --- Onyx AI Guard (direct /truefoundry path) ---
# Guard Token from an AI Guard policy URL in the Onyx platform
# (Policies → Runtime Policies → AI Guard → ⋮ → AI Guard URL).
# Used in: POST {ONYX_API_BASE}/guard/evaluate/v1/{ONYX_API_KEY}/truefoundry
ONYX_API_KEY=
# Required: set this to your tenant's AI Guard host.
# https://ai-guard.onyx.security is not routed to any tenant (it 404s).
# Format: https://<routing-id>.ai-guard.onyx.security
ONYX_API_BASE=https://<routing-id>.ai-guard.onyx.security
# Optional: per-call timeout in seconds (default: 10)
# ONYX_TIMEOUT=10

# --- Optional local forwarder only ---
# Production: point Custom Guardrails at Onyx /truefoundry directly (Auth Data empty).
# WRAPPER_API_KEY is only needed if you run the local FastAPI forwarder in this folder.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# WRAPPER_API_KEY=change-me-to-a-random-string

# --- Server (local forwarder) ---
PORT=8000
LOG_LEVEL=info

# --- TrueFoundry deploy (used by deploy.py only; optional forwarder host) ---
# TFY_WORKSPACE_FQN=<cluster>:<workspace>
# TFY_PUBLIC_HOST=ml.<cluster>.truefoundry.cloud
# TFY_PUBLIC_PATH=/onyx-guardrails-tfy
# ONYX_API_KEY_SECRET_FQN=tfy-secret://<workspace>/onyx-guardrails-tfy/onyx-api-key
# WRAPPER_API_KEY_SECRET_FQN=tfy-secret://<workspace>/onyx-guardrails-tfy/wrapper-api-key
