# Copy to .env and fill in. Do NOT commit .env.

# --- Knostic API (from your Knostic tenant / customer success) ---
KNOSTIC_API_KEY=
# Tenant API host (confirm with Knostic — defaults below are placeholders)
# KNOSTIC_API_BASE=https://api.knostic.ai
# KNOSTIC_INSPECT_PATH=/v1/guardrails/inspect
# KNOSTIC_SANITIZE_PATH=/v1/guardrails/sanitize
# Optional need-to-know policy id for runtime enforcement
# KNOSTIC_POLICY_ID=

# --- Wrapper auth (the TrueFoundry gateway calls us with this Bearer token) ---
WRAPPER_API_KEY=change-me-to-a-random-string

# --- Server ---
PORT=8000
LOG_LEVEL=info

# --- Live integration tests (optional) ---
# KNOSTIC_LIVE_TESTS=1

# --- TrueFoundry deploy (used by deploy.py only) ---
# TFY_WORKSPACE_FQN=<workspace>:<name>
# TFY_PUBLIC_HOST=ml.<cluster>.truefoundry.cloud
# TFY_PUBLIC_PATH=/knostic-guardrails/
# KNOSTIC_API_KEY_SECRET_FQN=tfy-secret://<workspace>/knostic-guardrails-tfy/knostic-api-key
# WRAPPER_API_KEY_SECRET_FQN=tfy-secret://<workspace>/knostic-guardrails-tfy/wrapper-api-key
