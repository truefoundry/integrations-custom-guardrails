# --- NeuralTrust TrustGuard ---------------------------------------------
# Collector API key (tgk_...) from TrustGuard console -> Collectors -> <collector> -> Auth.
NEURALTRUST_API_KEY=
# Public TrustGuard origin for your workspace (console -> collector -> Connection tab).
# Default when unset: https://trustguard.neuraltrust.ai (SaaS). Self-hosted: your data-plane URL.
NEURALTRUST_BASE_URL=https://trustguard.neuraltrust.ai
# Timeout for each /v1/evaluate call, in seconds. Default 3.5, capped at 4.5 so the wrapper
# answers before the AI Gateway's ~5 s guardrail wait. On timeout the wrapper returns HTTP 502
# and the TrueFoundry Enforcing Strategy decides (Enforce = block, Ignore On Error = pass).
NEURALTRUST_TIMEOUT_SECONDS=3.5

# --- Wrapper ------------------------------------------------------------
# Bearer the TrueFoundry AI Gateway sends to THIS wrapper (Custom Bearer Auth).
# Independent from NEURALTRUST_API_KEY. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
WRAPPER_API_KEY=
# How a TrustGuard `ask` verdict is handled (a gateway has no approval flow): block | allow
TRUSTGUARD_ASK_ACTION=block
# How a `transform` verdict is handled on a *Validate* route (no rewrite possible there): allow | block
TRUSTGUARD_TRANSFORM_ON_VALIDATE=allow
LOG_LEVEL=info
