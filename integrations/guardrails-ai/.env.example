# Copy to .env and fill in. Do NOT commit .env.

# --- Guardrails AI ---
# Token from https://hub.guardrailsai.com/keys. Required to install validators
# from the Guardrails Hub (used at build time AND for local Phase 0 setup).
GUARDRAILS_TOKEN=

# --- Wrapper auth (the TrueFoundry gateway calls us with this Bearer token) ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WRAPPER_API_KEY=change-me-to-a-random-string

# --- Server runtime ---
PORT=8000
LOG_LEVEL=info

# --- Deploy-time only (filled in before running deploy.py) ---
# Workspace FQN: `tfy workspace list` or copy from dashboard.
TFY_WORKSPACE_FQN=<cluster>:<workspace>
# Configured host: Integrations -> Clusters -> <cluster>.
TFY_PUBLIC_HOST=ml.<cluster>.truefoundry.cloud
# Path prefix for shared base domains. Leave blank if using wildcard subdomain.
TFY_PUBLIC_PATH=/guardrails-ai-tfy
# Secret FQNs (create secrets first in TFY dashboard, then paste their FQNs here).
WRAPPER_API_KEY_SECRET_FQN=tfy-secret://<workspace>/guardrails-ai-tfy/wrapper-api-key
GUARDRAILS_TOKEN_SECRET_FQN=tfy-secret://<workspace>/guardrails-ai-tfy/guardrails-token

# NOTE: unlike the NeMo wrapper, this wrapper does NOT call back to the TFY
# gateway -- all validators are local. So TFY_BASE_URL and JUDGE_MODEL are
# intentionally absent here.
