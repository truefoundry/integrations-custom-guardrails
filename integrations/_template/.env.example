# Copy to .env and fill in. Do NOT commit .env.

# --- Wrapper auth ---
# Random string. The TFY gateway sends this as `Authorization: Bearer ...` when calling the wrapper.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WRAPPER_API_KEY=change-me-to-a-random-string

# --- Server runtime ---
PORT=8000
LOG_LEVEL=info

# --- Vendor-specific env vars go here ---
# VENDOR_API_KEY=
# VENDOR_BASE_URL=

# --- Deploy-time only (filled in before running deploy.py) ---
TFY_WORKSPACE_FQN=<cluster>:<workspace>
TFY_PUBLIC_HOST=ml.<cluster>.truefoundry.cloud
TFY_PUBLIC_PATH=/<vendor>-guardrails-tfy
WRAPPER_API_KEY_SECRET_FQN=tfy-secret://<workspace>/<vendor>-guardrails-tfy/wrapper-api-key
# VENDOR_API_KEY_SECRET_FQN=tfy-secret://<workspace>/<vendor>-guardrails-tfy/vendor-api-key
