# Copy to .env and fill in. Do NOT commit .env.

# --- HiddenLayer AISec credentials ---
# OAuth2 client credentials from the AISec Platform Console (API Keys tab).
HIDDENLAYER_CLIENT_ID=
HIDDENLAYER_CLIENT_SECRET=

# Project ID or alias for HL-Project-Id header (required for detections/redaction).
HIDDENLAYER_PROJECT_ID=

# Optional. Region: us (default) or eu. API and auth hosts must match the tenant region.
# Resolved from this server-side env ONLY (never from per-request config).
# HIDDENLAYER_REGION=us

# Optional. Override API/auth base URLs (normally derived from region). Server-side env ONLY
# (never config-overridable) and must be https:// — this is the SSRF/credential-exfil boundary.
# HIDDENLAYER_API_BASE=https://api.hiddenlayer.ai
# HIDDENLAYER_AUTH_BASE=https://auth.hiddenlayer.ai

# Optional. Provider name sent in interaction metadata. Default: truefoundry
# HIDDENLAYER_PROVIDER=truefoundry

# Optional. Per-request timeout for calls to HiddenLayer. Default 10 (matches TFY gateway default).
# HIDDENLAYER_TIMEOUT_SECONDS=10

# Optional. Pass through on validate when HL returns DETECT (observe-only). Default: block.
# HIDDENLAYER_ALLOW_DETECT_ON_VALIDATE=false

# Optional. Behavior when HiddenLayer API is unavailable (5xx/timeout). Default: fail OPEN
# (traffic passes UNSCANNED on outage). Set to false to fail closed (block on outage) for
# safety-critical rails. Per-request config `fail_open_on_unavailable` can also set this.
# HIDDENLAYER_FAIL_OPEN_ON_UNAVAILABLE=true

# --- Wrapper auth (TrueFoundry gateway calls us with this Bearer token) ---
# REQUIRED. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# If empty/unset (or left as the example placeholder), the service FAILS CLOSED: every
# guardrail route returns HTTP 503. For local dev without a key, set ALLOW_NO_AUTH=true.
WRAPPER_API_KEY=

# Optional. Local development ONLY — disables wrapper bearer auth. Never set in production.
# ALLOW_NO_AUTH=false

# --- Server runtime ---
PORT=8000
LOG_LEVEL=info

# --- Deploy-time only (filled in before running deploy.py) ---
TFY_WORKSPACE_FQN=<cluster>:<workspace>
TFY_PUBLIC_HOST=ml.<cluster>.truefoundry.cloud
TFY_PUBLIC_PATH=/hiddenlayer-guardrails-tfy
WRAPPER_API_KEY_SECRET_FQN=tfy-secret://<workspace>/hiddenlayer-guardrails-tfy/wrapper-api-key
HIDDENLAYER_CLIENT_ID_SECRET_FQN=tfy-secret://<workspace>/hiddenlayer-guardrails-tfy/hiddenlayer-client-id
HIDDENLAYER_CLIENT_SECRET_SECRET_FQN=tfy-secret://<workspace>/hiddenlayer-guardrails-tfy/hiddenlayer-client-secret
