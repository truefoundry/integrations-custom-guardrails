# Copy to .env and fill in. Do NOT commit .env.

# --- LLM backend for NeMo's self-check rails (point at TrueFoundry gateway) ---
# Your tenant's OpenAI-compatible gateway base URL, ending in /v1
TFY_BASE_URL=https://<your-tenant>.truefoundry.cloud/api/llm/api/inference/openai/v1
# A TrueFoundry API key with access to the model you set as JUDGE_MODEL below
TFY_API_KEY=
# The model NeMo's self-check rails will call. Cheap + fast is best
# (e.g. openai-main/gpt-4o-mini, anthropic-main/claude-haiku-4-5, etc.)
JUDGE_MODEL=openai-main/gpt-4o-mini

# --- Wrapper auth (the TrueFoundry gateway calls us with this Bearer token) ---
WRAPPER_API_KEY=change-me-to-a-random-string

# --- Server ---
PORT=8000
LOG_LEVEL=info
