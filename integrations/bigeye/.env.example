# Copy to .env (gitignored). Never commit real values.

# --- Runtime (set on the service by deploy.py) ---
LOG_LEVEL=info
# Exact https hostnames the wrapper may forward the Bigeye API key to.
BIGEYE_ALLOWED_HOSTS=app.bigeye.com,demo.bigeye.com
# true logs each incoming payload with identity values redacted. Off by default.
LOG_PAYLOADS=false

# --- Deploy (deploy.py) ---
TFY_SERVICE_NAME=bigeye-guardrails-tfy
TFY_WORKSPACE_FQN=<cluster>:<workspace>
TFY_PUBLIC_HOST=ml.<cluster>.truefoundry.cloud
TFY_PUBLIC_PATH=

# --- Smoke test only (devtools/smoke_test.py). Not used by the service. ---
BIGEYE_URL=https://demo.bigeye.com
BIGEYE_API_KEY=
BIGEYE_WORKSPACE_ID=
BIGEYE_SOURCE_NAME=
# Optional. Bigeye warehouse type, e.g. snowflake or DATABASE_TYPE_SNOWFLAKE; leave empty to omit sourceType.
BIGEYE_WAREHOUSE_TYPE=
BIGEYE_CLEAN_TABLE=
BIGEYE_FLAGGED_COLUMN=
BIGEYE_TEST_SQL=
