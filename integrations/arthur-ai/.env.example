# Copy to .env and fill in. Do NOT commit .env.

# --- Arthur account ---
# Bearer token from the Arthur platform.
ARTHUR_API_KEY=

# Optional. Defaults to https://engine.platform.arthur.ai
# ARTHUR_API_BASE=https://engine.platform.arthur.ai

# Optional. Per-request timeout for calls to Arthur. Default 30.
# ARTHUR_TIMEOUT_SECONDS=30

# --- Wrapper auth (TrueFoundry gateway calls us with this Bearer token) ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WRAPPER_API_KEY=change-me-to-a-random-string

# --- Server runtime ---
PORT=8000
LOG_LEVEL=info

# --- Deploy-time only (filled in before running deploy.py) ---
TFY_WORKSPACE_FQN=<cluster>:<workspace>
TFY_PUBLIC_HOST=ml.<cluster>.truefoundry.cloud
TFY_PUBLIC_PATH=/arthur-guardrails-tfy
WRAPPER_API_KEY_SECRET_FQN=tfy-secret://<workspace>/arthur-guardrails-tfy/wrapper-api-key
ARTHUR_API_KEY_SECRET_FQN=tfy-secret://<workspace>/arthur-guardrails-tfy/arthur-api-key
