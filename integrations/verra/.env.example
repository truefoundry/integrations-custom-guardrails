# Copy to .env and fill in. Do NOT commit .env.

# --- Verra account ---
# Bearer token minted in the Verra dashboard for your org's TF integration.
# Sign up at https://helloverra.com.
VERRA_KEY=

# Optional. Defaults to https://api.helloverra.com.
# VERRA_API_BASE=https://api.helloverra.com

# Optional. Per-request timeout for the call to Verra. Default 30.
# VERRA_TIMEOUT_SECONDS=30

# --- Wrapper auth (the TrueFoundry gateway calls us with this Bearer token) ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WRAPPER_API_KEY=change-me-to-a-random-string

# --- Server runtime ---
PORT=8000
LOG_LEVEL=info

# --- Deploy-time only (filled in before running deploy.py) ---
TFY_WORKSPACE_FQN=<cluster>:<workspace>
TFY_PUBLIC_HOST=ml.<cluster>.truefoundry.cloud
TFY_PUBLIC_PATH=/verra-guardrails-tfy
WRAPPER_API_KEY_SECRET_FQN=tfy-secret://<workspace>/verra-guardrails-tfy/wrapper-api-key
VERRA_KEY_SECRET_FQN=tfy-secret://<workspace>/verra-guardrails-tfy/verra-key
