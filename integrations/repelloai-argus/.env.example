# Copy to .env and fill in. Do NOT commit .env.

# --- Wrapper auth ---
# Random string. The TFY gateway sends this as `Authorization: Bearer ...` when calling the wrapper.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WRAPPER_API_KEY=change-me-to-a-random-string

# --- RepelloAI Argus ---
# Runtime SDK key from the Argus dashboard (starts with rsk_).
ARGUS_API_KEY=rsk_...
# Default asset whose dashboard-configured policies apply to all gateway traffic.
ARGUS_ASSET_ID=
# Both values above are defaults. A guardrail config can override either through
# the dashboard Config field, which takes precedence for that config only:
#   {"assetId": "...", "credentials": {"apiKey": "rsk_..."}}
# Both env vars are still required: startup verification runs before any Config.
ARGUS_API_BASE=https://argusapi.repello.ai/sdk/v1

# Client timeout for Argus calls, in seconds. Must stay strictly below the
# gateway's timeout (10s default) so the wrapper reports a usable error instead
# of the gateway giving up first.
ARGUS_TIMEOUT_S=6.0

# Maximum characters sent to Argus per content unit.
ARGUS_MAX_TEXT_CHARS=20000

# --- Server runtime ---
PORT=8000
LOG_LEVEL=info

# --- Deploy-time only (filled in before running deploy.py) ---
TFY_WORKSPACE_FQN=<cluster>:<workspace>
TFY_PUBLIC_HOST=ml.<cluster>.truefoundry.cloud
TFY_PUBLIC_PATH=/repelloai-argus-guardrails-tfy
WRAPPER_API_KEY_SECRET_FQN=tfy-secret://<workspace>/repelloai-argus-guardrails-tfy/wrapper-api-key
ARGUS_API_KEY_SECRET_FQN=tfy-secret://<workspace>/repelloai-argus-guardrails-tfy/argus-api-key
